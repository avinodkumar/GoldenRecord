# Copy to .env and fill in what you use. Never commit .env.

# --- LLM for the agents: none | anthropic | azure_openai | ollama -------------------------
# "none" runs every agent on its deterministic rules (works offline, no cost).
LLM_PROVIDER=none
LLM_MAX_CALLS_PER_RUN=50
LLM_PAIRS_PER_CALL=10

# anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# azure_openai (closest to Fabric AI Functions)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ollama (start with: docker compose --profile ollama up -d; then pull a model, see README)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.2

# --- Pipeline -----------------------------------------------------------------------------
BOOTSTRAP=true          # generate synthetic data and run once on first start
SCHEDULE_MINUTES=0      # >0 runs the pipeline on a timer (Data Factory schedule stand-in)
ALERT_WEBHOOK_URL=      # Teams/Slack incoming webhook for Sentinel alerts (optional)

# --- Fabric deploy kit (toolbox) ------------------------------------------------------------
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE=ws-goldenrecord-dev
FABRIC_LAKEHOUSE=lh_goldenrecord
