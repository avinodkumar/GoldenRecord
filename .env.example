# Copy to .env and fill in what you use. Never commit .env.

# --- LLM for the dev harness: none | azure_openai ----------------------------------------
# In Fabric the agents use Fabric AI Functions (no keys). Here, "none" runs the deterministic fallbacks.
LLM_PROVIDER=none
LLM_MAX_CALLS_PER_RUN=50
LLM_PAIRS_PER_CALL=10
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- PII tokenization key (Key Vault in Fabric). Leave empty only for local throwaway data. ---
PII_TOKEN_KEY=

# --- Pipeline -----------------------------------------------------------------------------
BOOTSTRAP=true          # generate synthetic data and run once on first start
SCHEDULE_MINUTES=0      # >0 runs the pipeline on a timer (Data Factory schedule stand-in)
ALERT_WEBHOOK_URL=      # Teams/Slack incoming webhook for Sentinel alerts (optional)

# --- Fabric deploy kit (toolbox) ------------------------------------------------------------
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
FABRIC_WORKSPACE=ws-goldenrecord-dev
FABRIC_LAKEHOUSE=lh_goldenrecord
